# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# --- Source: transcription_engine Postgres (read-only access is enforced by aqg) ---
TE_DATABASE_URL=postgresql+psycopg://bitcoin:bitcoin@127.0.0.1:5434/transcription_engine

# --- Web search (optional; without it grounding is transcript_only) ---
TAVILY_API_KEY=

# --- LLM providers (only the ones referenced in config.yaml are needed) ---
OLLAMA_HOST=http://127.0.0.1:11434
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Amazon Bedrock (provider bedrock, the current config.yaml) ---
# No key needed on EC2: boto3 uses the instance's IAM role. Only the region:
AWS_REGION=ap-south-2
# Local machine only (pick one; leave unset on EC2):
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
